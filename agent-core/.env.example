# Agent Core configuration. Copy to .env next to the package and fill in.
#
# This machine is the source of truth: Cursor, Whisper, the scheduler and every piece of assistant
# state live here. It listens on nothing publicly — it dials out to the Gateway.

INSTANCE_ID=home-macmini

# --- Gateway link ---
GATEWAY_URL=wss://gateway.example.com/rpc
# Must match CORE_TOKEN on the Gateway. Generate with: openssl rand -base64 48
CORE_TOKEN=
# Only ever disable against a local test gateway with a self-signed certificate.
VERIFY_TLS=true
RECONNECT_BASE_DELAY=1
RECONNECT_MAX_DELAY=60
PING_INTERVAL=20
PING_TIMEOUT=20

# --- Authorization ---
# Namespaced Telegram ids. This is the real allowlist; the Gateway's is advisory.
ALLOWED_USERS=tg:123456789

# --- Storage ---
DATA_DIR=~/.personal-assistant
# DATABASE_PATH=
# TEMP_DIR=
# Filesystem and project allowlists. Defaults to DATA_DIR/assistant.toml.
# CONFIG_FILE=

# --- Cursor Agent ---
AGENT_BACKEND=acp
CURSOR_AGENT_BINARY=cursor-agent
# CURSOR_MODEL=
AGENT_STARTUP_TIMEOUT=60
# A long coding turn can legitimately run for many minutes.
AGENT_PROMPT_TIMEOUT=1800
# Sandbox directory for ordinary chat sessions. Cursor's built-in file writes and shell commands do
# not go through the permission callback (docs/cursor-acp.md), so the chat session must not be
# rooted anywhere that matters. Defaults to DATA_DIR/workspace.
# ASSISTANT_WORKSPACE=

# --- MCP (loopback only) ---
MCP_HOST=127.0.0.1
MCP_PORT=8931
# Authenticates Cursor's tool calls to this process. openssl rand -base64 48
MCP_TOKEN=

# --- Speech to text ---
# local = faster-whisper on this machine; gpu = the transcription service on the CUDA host.
STT_BACKEND=local
# LAN address of gpu-transcriber, and the token from its service.env. Both machines must agree.
STT_GPU_URL=http://10.0.7.49:17493
STT_GPU_TOKEN=
# STT_GPU_POLL_INTERVAL=2
# When STT_BACKEND=gpu, use local CPU whisper if the GPU host is down. Set false to fail instead.
STT_CPU_FALLBACK=true
# Accuracy over speed: large-v3 on an Intel CPU is slow, and that is the accepted trade-off.
STT_MODEL=large-v3
STT_DEVICE=cpu
# auto resolves to int8 on CPU, which is the only thing an Intel Mac can actually run.
STT_COMPUTE_TYPE=auto
STT_LANGUAGE=auto
# Two concurrent large-v3 runs on this hardware are slower than one after the other.
STT_MAX_CONCURRENT=1
STT_BEAM_SIZE=5
STT_VAD_FILTER=true
MAX_AUDIO_SIZE_MB=500
MAX_AUDIO_DURATION_SECONDS=14400
UPLOAD_IDLE_TIMEOUT=300

# --- YouTube ---
# yt-dlp runs on the proxy VPS over SSH; this toml holds that host, its key and the local paths.
# YOUTUBE_CONFIG=~/.personal-assistant/youtube/config.toml

# --- Behaviour ---
DEFAULT_TIMEZONE=Europe/Moscow
# How long a confirmation prompt waits before it expires as a refusal.
CONFIRMATION_TIMEOUT_SECONDS=900
SCHEDULER_TICK_SECONDS=5
# Above this many characters a transcript is treated as a recording to analyse rather than a spoken
# command: different prompt, and writes inferred from it require confirmation.
LONG_TRANSCRIPT_CHARS=1200
TRANSCRIPT_CHUNK_CHARS=12000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
