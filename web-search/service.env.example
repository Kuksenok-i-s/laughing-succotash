# Copy to ~/.config/web-search/service.env with mode 600 and fill in the tokens.
#
# SEARCH_TOKEN is the same value as SEARCH_SERVICE_TOKEN in the Core's .env. Generate it once:
#   openssl rand -base64 48

# Loopback is enough when Core and this service share a host (they normally do).
# Bind the LAN address only if they split.
SEARCH_HOST=127.0.0.1
SEARCH_PORT=17495
SEARCH_TOKEN=

# brave | searxng
SEARCH_BACKEND=searxng

# --- Brave Search API ---
# Key from https://api-dashboard.search.brave.com/. There is no free plan for new accounts: the
# Search plan is $5 per 1000 requests with $5 of credit every month, and that credit runs at one
# request per second. Set the dashboard's monthly credit limit to $5 and nothing is ever charged.
SEARCH_BRAVE_API_KEY=
# SEARCH_BRAVE_URL=https://api.search.brave.com/res/v1/web/search

# --- SearXNG ---
# Self-hosted next to this service: deploy/searxng/docker-compose.yml. Its settings.yml must list
# json under search.formats, otherwise /search?format=json answers 403 and every query fails.
SEARCH_SEARXNG_URL=http://127.0.0.1:8888
# Restrict the upstream engines it aggregates. Empty leaves the instance defaults alone.
# SEARCH_SEARXNG_ENGINES=duckduckgo,wikipedia,brave

# --- Queries ---
SEARCH_DEFAULT_LIMIT=5
SEARCH_MAX_LIMIT=20
# Batch cap. The factcheck pass sends one query per claim, all at once.
SEARCH_MAX_QUERIES=10
SEARCH_DEFAULT_LANG=ru
SEARCH_REQUEST_TIMEOUT=10
# Upstream calls in flight per batch. 4 suits a self-hosted SearXNG, which has no rate limit.
# Drop to 1 for Brave on the monthly credit, which allows one request per second.
SEARCH_PARALLEL=4

# --- Cache ---
# A stale result is worse than a slow one, so minutes rather than hours.
SEARCH_CACHE_TTL_SECONDS=900
SEARCH_CACHE_MAX_ENTRIES=512
SEARCH_SWEEP_INTERVAL_SECONDS=60

# --- Page fetching (web_fetch) ---
# Set false to leave the assistant with snippets only and no way to open a page.
SEARCH_FETCH_ENABLED=true
SEARCH_FETCH_TIMEOUT=15
SEARCH_FETCH_MAX_BYTES=4194304
SEARCH_FETCH_MAX_CHARS=20000

SEARCH_USER_AGENT=personal-assistant-search/1.0
SEARCH_LOG_LEVEL=INFO
SEARCH_LOG_FORMAT=text
