[Unit]
# User unit for faster-whisper on Jetson Xavier. CTranslate2 is a CUDA 11.4 build
# (sm_72, no flash-attn) installed to ~/.local/opt/ctranslate2.
Description=Transcription service (faster-whisper large-v3, CUDA float16)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/tg_bot_kirpich
EnvironmentFile=%h/.config/gpu-transcriber/service.env
Environment=PYTHONPATH=%h/tg_bot_kirpich/gpu-transcriber
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:%h/.assistant/venv-whisper/bin:/usr/bin:/bin
Environment=LD_LIBRARY_PATH=%h/.local/opt/ctranslate2/lib:/usr/local/cuda/lib64
Environment=TMPDIR=%h/.gpu-transcriber/tmp
Environment=TEMP=%h/.gpu-transcriber/tmp
Environment=TMP=%h/.gpu-transcriber/tmp
ExecStart=%h/.assistant/venv-whisper/bin/python -m gpu_transcriber.main
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5

NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gpu-transcriber

[Install]
WantedBy=default.target
