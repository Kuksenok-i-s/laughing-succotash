# Copy to ~/.config/handwriting-ocr/service.env with mode 600 and fill in the token.
#
# The same token goes into OCR_SERVICE_TOKEN in the Core's .env on this host. Generate it once:
#   openssl rand -base64 48

# Bind the LAN address when Core is on another host.
# Loopback is enough when Core and OCR share a machine.
OCR_HOST=0.0.0.0
OCR_PORT=17494
OCR_TOKEN=

# ollama | llamacpp. llama.cpp llama-server uses the OpenAI /v1 API, not Ollama.
OCR_BACKEND=llamacpp
OCR_LLAMA_URL=http://127.0.0.1:8081
OCR_MODEL=ovis-ocr2

# Ollama path (OCR_BACKEND=ollama). Leave unused on the llama.cpp host.
# OCR_OLLAMA_URL=http://127.0.0.1:11434
# OCR_OLLAMA_KEEP_ALIVE=1h
OCR_REQUEST_TIMEOUT=600
# Cap each VL reply. Ovis still loops after the page ends; strip_repeats cuts the tail.
OCR_MAX_TOKENS=2048
# Fit every image to this long edge before llama.cpp. 1024 keeps receipt type readable.
OCR_IMAGE_MAX_EDGE=1024
# 1 = page only; 2 = page + at most one small unreadable fragment.
OCR_MAX_PASSES=2
# triage = Qwen JSON. ocr = one-shot document prompt for OvisOCR2 / GLM-OCR.
OCR_PIPELINE=ocr

# Image spool. Nothing here outlives the TTL, and nothing here is ever /tmp.
OCR_WORK_DIR=~/.handwriting-ocr
OCR_JOB_TTL_SECONDS=21600
# Drop Qwen3-VL after this many quiet seconds so Whisper can use the same card. 0 keeps it loaded.
OCR_IDLE_UNLOAD_SECONDS=3600
OCR_MAX_UPLOAD_MB=32

OCR_LOG_LEVEL=INFO
OCR_LOG_FORMAT=text

# On-demand model: install the user llama-server-ocr.service without enabling it.
# OCR_MANAGE_LLAMA_SERVICE=true
# OCR_GPU_LOCK_PATH=~/.cache/assistant-gpu.lock
