# Copy to ~/.config/handwriting-ocr/service.env with mode 600 and fill in the token.
#
# The same token goes into OCR_SERVICE_TOKEN in the Core's .env on this host. Generate it once:
#   openssl rand -base64 48

# Loopback only — Core on this host uses http://127.0.0.1:17494.
# Override to a LAN address only if Core moves to another machine.
OCR_HOST=127.0.0.1
OCR_PORT=17494
OCR_TOKEN=

# Ollama lives on this same GPU host. Do not publish it on the LAN — only the OCR API.
OCR_OLLAMA_URL=http://127.0.0.1:11434
OCR_MODEL=qwen3-vl:2b
# Keep weights at least as long as OCR_IDLE_UNLOAD_SECONDS so the worker, not Ollama, is the source of truth.
OCR_OLLAMA_KEEP_ALIVE=10m
OCR_REQUEST_TIMEOUT=600

# Image spool. Nothing here outlives the TTL, and nothing here is ever /tmp.
OCR_WORK_DIR=/home/ilya/.handwriting-ocr
OCR_JOB_TTL_SECONDS=21600
# Drop Qwen3-VL after this many quiet seconds so Whisper can use the same card. 0 keeps it loaded.
OCR_IDLE_UNLOAD_SECONDS=600
OCR_MAX_UPLOAD_MB=32

OCR_LOG_LEVEL=INFO
OCR_LOG_FORMAT=text
