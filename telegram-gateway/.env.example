# Telegram Gateway configuration. Copy to .env next to the package and fill in.
#
# This machine is the exposed one. It holds exactly two secrets and no assistant data: no memory,
# no notes, no Cursor credentials. Losing this host must not lose anything but transport state.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:replace-me

# Advisory allowlist, namespaced. The Core re-checks every request against its own list, so this
# only avoids waking the Mac mini for strangers.
ALLOWED_USERS=tg:123456789

# --- Agent Core link ---
# The Core dials in to this address, so it must be reachable and TLS-terminated (nginx/caddy in
# front of this port is the expected setup).
HOST=0.0.0.0
PORT=8080
RPC_PATH=/rpc

# Shared service token. Generate with: openssl rand -base64 48
# Must match CORE_TOKEN on the Agent Core. Rotate by setting it on both sides and restarting.
CORE_TOKEN=

# --- Storage (transport state only) ---
DATA_DIR=~/.telegram-gateway
# DATABASE_PATH=
# TEMP_DIR=

# --- Limits ---
MAX_DOWNLOAD_MB=500
UPLOAD_CHUNK_SIZE=262144
RPC_CALL_TIMEOUT=30
# How long a Telegram handler may wait for the Core to accept a submit. The Core answers in
# milliseconds; anything slower means it is unhealthy and the request should stay queued.
SUBMIT_TIMEOUT=15

# Minimum seconds between edits of a job's status message, to stay clear of Telegram rate limits.
STATUS_EDIT_MIN_INTERVAL=3
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_RETRY_BASE_DELAY=2

# --- Logging ---
LOG_LEVEL=INFO
# json for aggregation, text for a terminal
LOG_FORMAT=json
