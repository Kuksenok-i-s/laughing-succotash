# Copy to ~/.config/gpu-transcriber/service.env with mode 600 and fill in the token.
#
# The same token goes into STT_GPU_TOKEN in the Core's .env on this host. Generate it once:
#   openssl rand -base64 48

# Loopback only — Core on this host uses http://127.0.0.1:17493.
# Override to a LAN address only if Core moves to another machine.
GPU_STT_HOST=127.0.0.1
GPU_STT_PORT=17493
GPU_STT_TOKEN=

# A path to a converted model, or a name for the Systran/faster-whisper-* cache in ~/.cache.
GPU_STT_MODEL=large-v3
GPU_STT_DEVICE=cuda
GPU_STT_COMPUTE_TYPE=float16
GPU_STT_BEAM_SIZE=5
GPU_STT_VAD_FILTER=true

# Audio spool. Nothing here outlives the TTL, and nothing here is ever /tmp.
GPU_STT_WORK_DIR=/home/ilya/.gpu-transcriber
GPU_STT_JOB_TTL_SECONDS=21600
# Drop large-v3 after this many quiet seconds so OCR can use the same card. 0 keeps it loaded.
GPU_STT_IDLE_UNLOAD_SECONDS=600
GPU_STT_MAX_UPLOAD_MB=512

GPU_STT_LOG_LEVEL=INFO
GPU_STT_LOG_FORMAT=text
