# Copy to ~/.config/gpu-transcriber/service.env with mode 600 and fill in the token.
#
# The same token goes into STT_GPU_TOKEN in the Core's .env on this host. Generate it once:
#   openssl rand -base64 48

# Loopback — Core on the same host (Xavier) uses http://127.0.0.1:17493.
GPU_STT_HOST=127.0.0.1
GPU_STT_PORT=17493
GPU_STT_TOKEN=

# A path to a converted model, or a name for the Systran/faster-whisper-* cache in ~/.cache.
GPU_STT_MODEL=large-v3-turbo
GPU_STT_DEVICE=cuda
GPU_STT_COMPUTE_TYPE=int8_float16
# Beam 2: the decoder is the bottleneck on Xavier; turbo barely changes between 2 and 5.
GPU_STT_BEAM_SIZE=2
GPU_STT_VAD_FILTER=true
# VAD windows decoded together (needs VAD). 0 disables batching.
GPU_STT_BATCH_SIZE=8

# Audio spool. Nothing here outlives the TTL, and nothing here is ever /tmp.
GPU_STT_WORK_DIR=/home/ilya/.gpu-transcriber
GPU_STT_JOB_TTL_SECONDS=21600
# Drop the model after this many quiet seconds. 0 keeps it loaded — use 0 on a host with no OCR
# (Xavier): a cold load costs tens of seconds per voice note. On the host shared with OCR (AGX)
# 180 keeps the weights warm between the slices of one recording; they are dropped immediately
# anyway when OCR takes GPU_STT_GPU_LOCK_PATH.
GPU_STT_IDLE_UNLOAD_SECONDS=600
# Split recordings longer than this (seconds) so CUDA memory stays bounded. 0 disables.
# Five minutes: large-v3 float16 OOMed on ~10-minute files under the 5G unit cap.
GPU_STT_CHUNK_SECONDS=300
GPU_STT_CHUNK_OVERLAP_SECONDS=2
GPU_STT_MAX_UPLOAD_MB=512

GPU_STT_LOG_LEVEL=INFO
GPU_STT_LOG_FORMAT=text

# Shared OCR host only; match OCR_GPU_LOCK_PATH. Disables preload and unloads after jobs.
# GPU_STT_GPU_LOCK_PATH=/home/nvidia/.cache/assistant-gpu.lock
